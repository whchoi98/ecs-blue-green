# ecs-blue-green environment variables
# Copy this file to .env and fill in your values.
# .env is NEVER committed to git.

# AWS Configuration
AWS_REGION=ap-northeast-2
# AWS_ACCOUNT_ID=123456789012   # Optional; CDK reads from STS if not set

# CDK Context defaults (can also be passed with --context on CLI)
# CDK_INCLUDE_GREEN=false
# CDK_INCLUDE_SECONDARY_CIDR=false
# CDK_INCLUDE_ROLLING=false

# Application (used in Docker containers — set via ECS task environment, not here)
# COLOR=blue
# VERSION=v1
# PORT=3000

# Redis (resolved from CDK CfnOutput at deploy time — do not hardcode here)
# REDIS_HOST=

# Aurora MySQL (resolved from CDK CfnOutput at deploy time — do not hardcode here)
# DB_HOST=
# DB_USER=
# DB_PASS=
# DB_NAME=

# Claude Code Notifications (optional)
# CLAUDE_NOTIFY_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
